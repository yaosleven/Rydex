---
import { getEntry } from 'astro:content';

const [site, about, contact, b2b] = await Promise.all([
  getEntry('settings', 'site'), getEntry('pages', 'about'), getEntry('pages', 'contact'), getEntry('landingPages', 'oem-manufacturer'),
]);
if (!site || !about || !contact || !b2b) throw new Error('Missing content needed by the visual editor.');

const sections = [
  { id: 'site', title: '全站品牌与联系信息', fields: [['companyName', '公司名称', site.data.companyName], ['email', '联系邮箱', site.data.email], ['phone', '联系电话', site.data.phone], ['address', '地址', site.data.address], ['whatsappUrl', 'WhatsApp 链接', site.data.whatsappUrl], ['footerDescription', '页脚介绍', site.data.footerDescription]] },
  { id: 'about', title: 'About 页面', fields: [['heroTitle', '主标题', about.data.copy.heroTitle], ['introTitle', '介绍标题', about.data.copy.introTitle], ['introBody', '介绍正文', about.data.copy.introBody], ['showroomTitle', '展厅标题', about.data.copy.showroomTitle], ['showroomAddress', '展厅地址', about.data.copy.showroomAddress], ['heroDesktop', '桌面端主图路径', about.data.images.heroDesktop], ['heroMobile', '移动端主图路径', about.data.images.heroMobile]] },
  { id: 'contact', title: 'Contact 页面', fields: [['heroTitle', '主标题', contact.data.copy.heroTitle], ['heroBody', '介绍文字', contact.data.copy.heroBody], ['chatLabel', '聊天渠道名称', contact.data.copy.chatLabel], ['firstNamePlaceholder', '名字提示', contact.data.copy.firstNamePlaceholder], ['emailPlaceholder', '邮箱提示', contact.data.copy.emailPlaceholder], ['messagePlaceholder', '留言提示', contact.data.copy.messagePlaceholder], ['submitLabel', '提交按钮', contact.data.copy.submitLabel]] },
  { id: 'b2b', title: 'B2B 落地页', fields: [['heroTitle', '首屏标题', b2b.data.hero.title], ['heroDescription', '首屏说明', b2b.data.hero.description], ['primaryCta', '首要按钮', b2b.data.hero.primaryCta], ['desktopImage', '桌面端首图路径', b2b.data.hero.desktopImage], ['mobileImage', '移动端首图路径', b2b.data.hero.mobileImage], ['quoteTitle', '询盘表单标题', b2b.data.quoteForm.title], ['quoteDescription', '询盘表单说明', b2b.data.quoteForm.description], ['submitLabel', '询盘提交按钮', b2b.data.quoteForm.submitLabel]] },
];
---

<!doctype html>
<html lang="zh-CN">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="robots" content="noindex,nofollow" /><title>设置与页面编辑｜Rydex</title></head>
  <body>
    <main>
      <aside><a href="/admin/">Rydex 内容中心</a><nav><a href="/admin/home">首页编辑</a><a href="/admin/models">车型编辑</a><a href="/admin/articles">文章编辑</a><a href="/admin/library">页面与品牌</a><a class="active" href="/admin/settings">设置与页面</a></nav><p>本机草稿模式<br /><small>不会发布公开内容。</small></p></aside>
      <section class="workspace">
        <header><div><b>SITE & MARKETING CONTENT</b><h1>设置与页面编辑</h1><p>集中修改全站联系信息、About、Contact 与 B2B 落地页的重要字段。</p></div><a href="/admin/">← 内容中心</a></header>
        <div class="notice">草稿仅存在当前浏览器。图片可填写 <code>/assets/...</code> 路径或 HTTPS 地址；保存后可打开下面的前台草稿预览。</div>
        <div class="preview-row"><a href="/about.html?content-preview=1" target="_blank" rel="noreferrer">预览 About ↗</a><a href="/contact.html?content-preview=1" target="_blank" rel="noreferrer">预览 Contact ↗</a><a href="/lp/oem-manufacturer/?content-preview=1" target="_blank" rel="noreferrer">预览 B2B ↗</a></div>
        <form id="form">{sections.map((section) => <section class="card"><h2>{section.title}</h2><div class="grid">{section.fields.map(([key, label, value]) => <label>{label}<textarea name={`${section.id}.${key}`} rows={label.includes('正文') || label.includes('说明') || label.includes('介绍') ? 3 : 1}>{value}</textarea></label>)}</div></section>)}</form>
        <footer><span id="status">正在编辑网站默认内容。</span><div><button id="reset" class="secondary" type="button">恢复默认</button><button id="save" type="button">保存草稿</button></div></footer>
      </section>
    </main>
    <script id="data" type="application/json" is:inline set:html={JSON.stringify(sections)}></script>
    <script is:inline>
      const sections = JSON.parse(document.querySelector('#data')?.textContent || '[]');
      const key = 'rydex-site-page-draft-v1'; const form = document.querySelector('#form'); const status = document.querySelector('#status');
      let draft = {}; try { draft = JSON.parse(localStorage.getItem(key) || '{}'); } catch { draft = {}; }
      const render = () => sections.forEach((section) => section.fields.forEach(([name,,value]) => { const el = form.elements.namedItem(`${section.id}.${name}`); if (el) el.value = draft?.[section.id]?.[name] ?? value; }));
      const save = () => { const next = {}; sections.forEach((section) => { next[section.id] = {}; section.fields.forEach(([name]) => next[section.id][name] = form.elements.namedItem(`${section.id}.${name}`)?.value || ''); }); draft = next; localStorage.setItem(key, JSON.stringify(draft)); status.textContent = '草稿已保存到此浏览器。可打开上方链接查看前台草稿。'; };
      form.addEventListener('input', () => status.textContent = '有未保存的修改。'); document.querySelector('#save').addEventListener('click', save); document.querySelector('#reset').addEventListener('click', () => { localStorage.removeItem(key); draft = {}; render(); status.textContent = '已恢复网站默认内容。'; }); render();
    </script>
  </body>
</html>

<style>
  :root{font-family:Inter,system-ui,sans-serif;color:#17283a;background:#f3f6fa}*{box-sizing:border-box}body{margin:0}main{min-height:100vh;display:grid;grid-template-columns:250px minmax(0,1fr)}aside{display:flex;flex-direction:column;padding:28px 16px;background:#0b2440;color:#c5d5e3}aside>a{padding:0 10px 29px;color:#fff;text-decoration:none;font-weight:800}nav{display:grid;gap:5px}nav a{padding:13px 11px;border-radius:8px;color:#b9c9d8;text-decoration:none;font-size:14px}nav a:hover,nav .active{background:#17486f;color:#fff}aside p{margin:auto 10px 0;padding:14px;border:1px solid #ffffff22;border-radius:10px;font-size:12px}aside small{color:#9aafc2}.workspace{width:min(1120px,100%);margin:0 auto;padding:40px 36px 105px}header{display:flex;justify-content:space-between;gap:20px}header b{color:#5d7b9a;font-size:11px;letter-spacing:.09em}h1{margin:8px 0;font-size:36px;letter-spacing:-.045em}header p{margin:0;color:#6d8297}header>a{color:#26445f;font-weight:700;text-decoration:none}.notice{margin:28px 0 12px;padding:14px 16px;border:1px solid #e5cf82;border-radius:10px;background:#fff9e6;color:#745913;font-size:13px}.preview-row{display:flex;flex-wrap:wrap;gap:9px;margin:0 0 18px}.preview-row a{padding:8px 11px;border:1px solid #b9cedf;border-radius:7px;color:#215b88;background:#fff;text-decoration:none;font-size:13px;font-weight:700}.card{margin-top:17px;padding:24px;border:1px solid #dfe8ef;border-radius:12px;background:#fff}.card h2{margin:0 0 18px;font-size:18px}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px}.grid label{display:grid;gap:7px;color:#2a455e;font-size:13px;font-weight:700}textarea{width:100%;resize:vertical;border:1px solid #cfdae5;border-radius:7px;padding:11px 12px;background:#fff;color:#19334b;font:inherit;font-size:14px;line-height:1.45}footer{position:fixed;bottom:0;left:250px;right:0;display:flex;justify-content:space-between;align-items:center;padding:14px 36px;border-top:1px solid #dbe5ed;background:#fffffff2}footer span{color:#6e8397;font-size:13px}button{min-height:40px;margin-left:8px;padding:0 16px;border:0;border-radius:7px;background:#103a63;color:#fff;font-weight:700;cursor:pointer}.secondary{border:1px solid #d5e0eb;background:#fff;color:#26445f}@media(max-width:820px){main{grid-template-columns:1fr}aside{display:none}.workspace{padding:25px 16px 98px}header{flex-direction:column}.grid{grid-template-columns:1fr}footer{left:0;padding:12px 16px}footer span{display:none}}
</style>
