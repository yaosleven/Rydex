---
import { getEntry } from 'astro:content';
import ContentDraftPreview from '../components/admin/ContentDraftPreview.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  pageId?: string;
  collectionId?: string;
  itemSlug?: string;
}

const siteSettings = await getEntry('settings', 'site');
const defaultSeo = siteSettings?.data.defaultSeo ?? {
  title: 'Rydex - Webflow HTML website template',
  description: 'Rydex is a stylish and modern Webflow template for luxury car rentals.',
};

const {
  title = defaultSeo.title,
  description = defaultSeo.description,
  ogImage = defaultSeo.ogImage,
  pageId = '6856afca69c1086451cbfd45',
  collectionId,
  itemSlug,
} = Astro.props;
---

<!doctype html>
<html data-wf-domain="rydex.webflow.io" data-wf-page={pageId} data-wf-site="6856afca69c1086451cbfd3c" data-wf-status="1" data-wf-collection={collectionId} data-wf-item-slug={itemSlug} lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <meta name="theme-color" content="#0a0a09" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link rel="stylesheet" href="/static/css/rydex.webflow.shared.7368deef3.min.css" />
    <link rel="icon" href={siteSettings?.data.branding?.favicon ?? '/assets/logo.svg'} type="image/svg+xml" />
    <style is:inline>
      @media (min-width: 992px) {
        html.w-mod-js:not(.w-mod-ix) [data-w-id="0c92abab-f173-095e-23f2-bdbe32a17f15"],
        html.w-mod-js:not(.w-mod-ix) [data-w-id="0c92abab-f173-095e-23f2-bdbe32a17f24"],
        html.w-mod-js:not(.w-mod-ix) [data-w-id="0c92abab-f173-095e-23f2-bdbe32a17f33"] { width: 33%; }
      }

      :where(a, button, input, textarea, select):focus-visible {
        outline: 2px solid #f3e55b;
        outline-offset: 4px;
      }

      .w-webflow-badge {
        display: none !important;
      }

      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          scroll-behavior: auto !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
    <script is:inline src="/static/js/webfont.js"></script>
    <script is:inline>
      WebFont.load({ google: { families: ['Figtree:300,regular,500,600,700,800,900,300italic,italic,500italic,600italic,700italic,800italic:latin,latin-ext'] } });
      document.documentElement.className += ' w-mod-js';
      if ('ontouchstart' in window || (window.DocumentTouch && document instanceof window.DocumentTouch)) document.documentElement.className += ' w-mod-touch';
    </script>
    <script is:inline src="/static/js/jquery-3.5.1.min.dc5e7f18c8.js" defer></script>
    <script is:inline src="/static/js/webflow.schunk.36b8fb49256177c8.js" defer></script>
    <script is:inline src="/static/js/webflow.schunk.572e41d3cd72b794.js" defer></script>
    <script is:inline src="/static/js/webflow.34585818.cd6b3910a2af6589.js" defer></script>
  </head>
  <body>
    <slot />
    {siteSettings && <ContentDraftPreview storageKey="rydex-site-page-draft-v1" section="site" defaults={siteSettings.data} />}
  </body>
</html>
