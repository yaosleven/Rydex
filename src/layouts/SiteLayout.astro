---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Rydex — Luxury car rentals',
  description = 'Discover premium cars, effortless booking and exceptional service with Rydex.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" href="/assets/logo.svg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
