---
import WebflowDocument from '../layouts/WebflowDocument.astro';
import ModelsListing from '../components/models/ModelsListing.astro';
import { webflowModels } from '../utils/webflow-models';
import { getEntry } from 'astro:content';

const catalog = await getEntry('pages', 'catalog');
if (!catalog) throw new Error('Missing required catalog page content.');
---

<WebflowDocument pageId="68653ef4f6a44b398ddad1f3" title={catalog.data.seo?.title} description={catalog.data.seo?.description} ogImage={catalog.data.seo?.ogImage}>
  <ModelsListing markup={webflowModels} />
</WebflowDocument>
