---
export interface Props {
  as?: 'div' | 'section' | 'header' | 'footer';
  class?: string;
}

const { as: Tag = 'div', class: className } = Astro.props;
---

<Tag class:list={['clean-container', className]}>
  <slot />
</Tag>

<style>
  .clean-container {
    width: min(calc(100% - (var(--clean-gutter) * 2)), var(--clean-content-width));
    margin-inline: auto;
  }
</style>
