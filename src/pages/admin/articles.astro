---
import { getCollection } from 'astro:content';
const articles = (await getCollection('articles')).map(({ data }) => ({ slug:data.slug, title:data.title, category:data.category, description:data.description, publishedAt:data.publishedAt, cover:data.cover, authorName:data.author.name, authorAvatar:data.author.avatar, readTime:data.readTime, seoTitle:data.seo?.title ?? '', seoDescription:data.seo?.description ?? '', eyebrow:data.body.eyebrow, lead:data.body.lead, paragraphs:data.body.paragraphs }));
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="robots" content="noindex,nofollow" /><title>文章编辑｜Rydex</title></head><body><main><aside><a href="/admin/">Rydex 内容中心</a><nav><a href="/admin/home">首页编辑</a><a href="/admin/models">车型编辑</a><a class="active" href="/admin/articles">文章编辑</a><a href="/admin/settings">设置与页面</a></nav><p>本机草稿模式<br /><small>不会发布公开内容。</small></p></aside><section class="workspace"><header><div><b>ARTICLE CONTENT</b><h1>文章内容编辑</h1><p>管理文章标题、摘要、正文、封面、作者和 SEO。</p></div><a href="/admin/">← 内容中心</a></header><div class="notice">当前保存的是本机草稿；连接 CMS 后才可一键发布。</div><label class="picker">选择文章<select id="select">{articles.map(article => <option value={article.slug}>{article.title}</option>)}</select></label><form id="form"><section class="card"><h2>基本资料</h2><div id="basic" class="grid"></div></section><section class="card"><h2>文章正文</h2><div id="body" class="grid"></div></section><section class="card"><h2>搜索引擎信息</h2><div id="seo" class="grid"></div></section></form><footer><span id="status">正在编辑网站默认内容。</span><div><button id="reset" class="secondary" type="button">恢复默认</button><button id="save" type="button">保存草稿</button></div></footer></section></main><script id="data" type="application/json" is:inline set:html={JSON.stringify(articles)}></script><script is:inline>
const data=JSON.parse(document.querySelector('#data')?.textContent||'[]'),key='rydex-article-content-draft-v1',select=document.querySelector('#select'),form=document.querySelector('#form'),status=document.querySelector('#status');let drafts={};try{drafts=JSON.parse(localStorage.getItem(key)||'{}')}catch{}const fields=[['basic','title','文章标题','input'],['basic','category','分类（Events / Guides / Reviews）','input'],['basic','description','文章摘要','textarea'],['basic','publishedAt','发布日期（YYYY-MM-DD）','input'],['basic','cover','封面图片路径','input'],['basic','authorName','作者姓名','input'],['basic','authorAvatar','作者头像路径','input'],['basic','readTime','阅读时长','input'],['body','eyebrow','文章栏目标签','input'],['body','lead','开头引言','textarea'],...Array.from({length:5},(_,i)=>['body',`paragraph${i+1}`,`正文第 ${i+1} 段`,'textarea']),['seo','seoTitle','SEO 标题','input'],['seo','seoDescription','SEO 描述','textarea']];const base=()=>data.find(x=>x.slug===select.value)||data[0],current=()=>({...base(),...(drafts[base().slug]||{})});const add=(target,name,label,type)=>{const wrap=document.createElement('label'),el=document.createElement(type==='textarea'?'textarea':'input');wrap.textContent=label;el.name=name;if(type==='textarea')el.rows=type==='textarea'?3:0;wrap.append(el);target.append(wrap)};fields.forEach(([target,name,label,type])=>add(document.querySelector('#'+target),name,label,type));const render=()=>{const x=current();fields.forEach(([,name])=>{const el=form.elements.namedItem(name);if(!el)return;const value=name.startsWith('paragraph')?x.paragraphs?.[Number(name.slice(9))-1]:x[name];el.value=value||''});status.textContent=drafts[x.slug]?'已加载此文章本机草稿。':'正在编辑网站默认内容。'};const save=()=>{const x=base(),d={slug:x.slug,paragraphs:[]};fields.forEach(([,name])=>{const v=form.elements.namedItem(name)?.value||'';if(name.startsWith('paragraph'))d.paragraphs[Number(name.slice(9))-1]=v;else d[name]=v});drafts[x.slug]=d;localStorage.setItem(key,JSON.stringify(drafts));status.textContent='草稿已保存到此浏览器。'};select.addEventListener('change',render);form.addEventListener('input',()=>status.textContent='有未保存的修改。');document.querySelector('#save').addEventListener('click',save);document.querySelector('#reset').addEventListener('click',()=>{delete drafts[base().slug];localStorage.setItem(key,JSON.stringify(drafts));render();status.textContent='已恢复网站默认内容。'});render();
</script></body></html>
<style>:root{font-family:Inter,system-ui,sans-serif;color:#17283a;background:#f3f6fa}*{box-sizing:border-box}body{margin:0}main{min-height:100vh;display:grid;grid-template-columns:250px minmax(0,1fr)}aside{display:flex;flex-direction:column;padding:28px 16px;background:#0b2440;color:#c5d5e3}aside>a{padding:0 10px 29px;color:#fff;text-decoration:none;font-weight:800}nav{display:grid;gap:5px}nav a{padding:13px 11px;border-radius:8px;color:#b9c9d8;text-decoration:none;font-size:14px}nav .active{background:#17486f;color:#fff}aside p{margin:auto 10px 0;padding:14px;border:1px solid #ffffff22;border-radius:10px;font-size:12px}aside small{color:#9aafc2}.workspace{width:min(1120px,100%);margin:0 auto;padding:40px 36px 105px}header{display:flex;justify-content:space-between;gap:20px}header b{color:#5d7b9a;font-size:11px;letter-spacing:.09em}h1{margin:8px 0;font-size:36px;letter-spacing:-.045em}header p{margin:0;color:#6d8297}header>a{color:#26445f;font-weight:700;text-decoration:none}.notice{margin:28px 0 17px;padding:14px 16px;border:1px solid #e5cf82;border-radius:10px;background:#fff9e6;color:#745913;font-size:13px}.picker{display:grid;gap:7px;max-width:520px;color:#2a455e;font-size:13px;font-weight:700}select,input,textarea{width:100%;border:1px solid #cfdae5;border-radius:7px;padding:11px 12px;background:#fff;color:#19334b;font:inherit;font-size:14px}.card{margin-top:17px;padding:24px;border:1px solid #dfe8ef;border-radius:12px;background:#fff}.card h2{margin:0 0 18px;font-size:18px}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px}.grid label{display:grid;gap:7px;color:#2a455e;font-size:13px;font-weight:700}.grid label:has(textarea){grid-column:1/-1}textarea{resize:vertical;line-height:1.45}footer{position:fixed;bottom:0;left:250px;right:0;display:flex;justify-content:space-between;align-items:center;padding:14px 36px;border-top:1px solid #dbe5ed;background:#fffffff2}footer span{color:#6e8397;font-size:13px}button{min-height:40px;margin-left:8px;padding:0 16px;border:0;border-radius:7px;background:#103a63;color:#fff;font-weight:700;cursor:pointer}.secondary{border:1px solid #d5e0eb;background:#fff;color:#26445f}@media(max-width:820px){main{grid-template-columns:1fr}aside{display:none}.workspace{padding:25px 16px 98px}header{flex-direction:column}.grid{grid-template-columns:1fr}footer{left:0;padding:12px 16px}footer span{display:none}}</style>
