---
import WebflowDocument from '../layouts/WebflowDocument.astro';
import { getEntry } from 'astro:content';

const utility = await getEntry('pages', 'utility');

if (!utility) throw new Error('Missing required utility page content.');

const { copy } = utility.data;
---

<WebflowDocument title={`${copy.notFoundTitle} | Rydex`} description={copy.notFoundBody}>
  <main class="not-found" aria-labelledby="not-found-heading">
    <div class="not-found-content">
      <div class="not-found-code" aria-hidden="true">{copy.notFoundCode}</div>
      <div class="not-found-copy">
        <h1 id="not-found-heading">{copy.notFoundTitle}</h1>
        <p>{copy.notFoundBody}</p>
        <a href="/" class="not-found-link">{copy.notFoundCta} <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </main>
</WebflowDocument>

<style>
  .not-found { display: grid; min-height: 100svh; place-items: center; padding: 32px 20px; background: #070806; color: #fff; }
  .not-found-content { position: relative; width: min(100%, 720px); text-align: center; }
  .not-found-code { color: #3f403f; font-size: clamp(180px, 31vw, 320px); font-weight: 700; letter-spacing: -.12em; line-height: .72; }
  .not-found-copy { position: relative; margin-top: -12px; }
  .not-found-copy h1 { margin: 0; font-size: clamp(34px, 3.2vw, 48px); line-height: 1.1; }
  .not-found-copy p { max-width: 500px; margin: 16px auto 25px; color: rgba(255,255,255,.73); font-size: 15px; line-height: 1.6; }
  .not-found-link { display: inline-flex; min-width: 242px; align-items: center; justify-content: space-between; gap: 24px; padding: 4px 4px 4px 17px; border: 1px solid #d6dc00; border-radius: 11px; color: #d6dc00; font-size: 16px; }
  .not-found-link span { display: grid; width: 39px; height: 39px; place-items: center; border-radius: 8px; color: #111; background: #d6dc00; font-size: 25px; }
  @media (max-width: 479px) { .not-found-code { font-size: 172px; } .not-found-copy { margin-top: 0; } }
</style>
