---
interface Props {
  category: string;
  title: string;
  image: string;
}

const { category, title, image } = Astro.props;
---

<a class="blog-card" href="#journal" data-reveal>
  <img src={image} alt="" loading="lazy" />
  <div class="blog-card-copy">
    <p>{category}</p>
    <h3>{title}</h3>
    <span>Read story <b aria-hidden="true">↗</b></span>
  </div>
</a>
